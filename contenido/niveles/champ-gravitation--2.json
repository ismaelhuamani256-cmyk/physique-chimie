   "titulo": "Ejercicio BAC: el satélite en órbita",
   "preguntas": [
    {
     "pregunta": "Un satélite artificial de la Tierra describe una orbite circulaire autour de la Terre. Que peut-on dire de son mouvement dans le référentiel géocentrique ?",
     "opciones": [
      "Circulaire et uniforme : v est constante et l'accélération est radiale et centripète",
      "Circulaire et uniforme : l'accélération est nulle",
      "Circulaire mais accéléré : v augmente le long de l'orbite",
      "Rectiligne uniforme, car la gravitation compense l'inertie"
     ],
     "correcta": 0,
     "explicacion": "Avec la 2e loi de Newton, dv/dt = 0 : la vitesse est constante, mais l'accélération a = v²/r·n est radiale et centripète (non nulle).",
     "pagina_pdf": 341
    },
    {
     "pregunta": "Quelle est l'expression de la vitesse d'un satellite en orbite circulaire de rayon r autour d'un astre de masse M ?",
     "opciones": [
      "v = √(G·M/r)",
      "v = √(r/(G·M))",
      "v = G·M/r²",
      "v = (G·M·r)²"
     ],
     "correcta": 0,
     "explicacion": "De a = G·M/r² = v²/r on tire v² = G·M/r, soit v = √(G·M/r) : indépendante de la masse du satellite.",
     "pagina_pdf": 341
    },
    {
     "pregunta": "Pour un satellite de la Terre, le rayon de l'orbite vaut r = 7,2×10⁶ m, avec R_T = 6,4×10⁶ m. Quelle est son altitude h ?",
     "opciones": [
      "h = 0,8×10⁶ m (r = R_T + h)",
      "h = 13,6×10⁶ m (r + R_T)",
      "h = 7,2×10⁶ m (h = r)",
      "h = 46×10¹² m (r × R_T)"
     ],
     "correcta": 0,
     "explicacion": "r = R_T + h donc h = r − R_T = 7,2×10⁶ − 6,4×10⁶ = 8×10⁵ m = 800 km.",
     "pagina_pdf": 341
    },
    {
     "pregunta": "Comment s'écrit la 3e loi de Kepler pour un satellite sur une orbite de demi-grand axe a et de période T autour d'un astre de masse M ?",
     "opciones": [
      "T²/a³ = 4π²/(G·M)",
      "T³/a² = 4π²/(G·M)",
      "T²·a³ = 4π²/(G·M)",
      "T/a = 4π²/(G·M)"
     ],
     "correcta": 0,
     "explicacion": "La 3e loi de Kepler donne T²/a³ = k avec k = 4π²/(G·M) ; la constante ne dépend que de l'astre attracteur.",
     "pagina_pdf": 340
    }
   ]
