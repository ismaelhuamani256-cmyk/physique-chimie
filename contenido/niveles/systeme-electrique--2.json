   "preguntas": [
    {
     "pregunta": "Un condensateur de capacité C est soumis à une tension u. La charge q portée par son armature s'écrit :",
     "opciones": [
      "q = C · u",
      "q = C / u",
      "q = u / C",
      "q = C · u²"
     ],
     "correcta": 0,
     "explicacion": "La charge est proportionnelle à la tension, le coefficient de proportionnalité étant la capacité : q = C·u.",
     "pagina_pdf": 522
    },
    {
     "pregunta": "Lors de la charge d'un condensateur dans un circuit RC série alimenté par un générateur idéal de tension continue E, la tension u_C :",
     "opciones": [
      "tend vers 0",
      "augmente progressivement jusqu'à E",
      "reste constante",
      "diminue puis s'annule"
     ],
     "correcta": 1,
     "explicacion": "u_C(t) = E·(1 − e^(−t/RC)) est croissante et tend vers la valeur imposée par le générateur.",
     "pagina_pdf": 524
    },
    {
     "pregunta": "Avec R = 10 kΩ et C = 100 nF, l'ordre de grandeur du temps caractéristique du circuit RC série vaut :",
     "opciones": [
      "τ = 10³ s",
      "τ = 10⁻³ s",
      "τ = 10¹ s",
      "τ = 10⁻⁶ s"
     ],
     "correcta": 1,
     "explicacion": "τ = R·C = 10×10³ × 100×10⁻⁹ = 1×10⁻³ s.",
     "pagina_pdf": 527
    },
    {
     "pregunta": "Un dipôle a un comportement capacitif lorsque :",
     "opciones": [
      "la tension u est en avance de phase sur l'intensité i",
      "l'intensité i est en avance de phase sur la tension u",
      "i et u sont toujours en phase",
      "i est nulle quel que soit u"
     ],
     "correcta": 1,
     "explicacion": "i = C·du/dt : u et i ne peuvent pas être en phase, c'est i qui est en avance de phase sur u.",
     "pagina_pdf": 523
    },
    {
     "pregunta": "Dans la charge d'un condensateur initialement déchargé, à la date t = τ la tension u_C vaut :",
     "opciones": [
      "0,37 × E",
      "0,63 × E",
      "E",
      "0,5 × E"
     ],
     "correcta": 1,
     "explicacion": "u_C(τ) = E(1 − e^(−1)) = 0,63·E ; on considère le condensateur chargé au bout de 5τ.",
