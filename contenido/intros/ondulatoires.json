  },
  {
   "t": 7,
   "accion": "formula",
   "latex": "\\delta = k\\lambda \\Rightarrow \\text{constructivas}\\ ;\\ \\delta=\\left(k+\\tfrac{1}{2}\\right)\\lambda \\Rightarrow \\text{destructivas}"
  },
  {
   "t": 7.2,
   "accion": "subtitulo",
   "texto": "En fase (δ = kλ) se refuerzan; en oposición de fase (δ = (k+½)λ) se anulan."
