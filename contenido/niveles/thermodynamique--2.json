   "titulo": "Rey Bomba : premier principe et lois thermiques",
   "preguntas": [
    {
     "pregunta": "Pour un système fermé au repos, le premier principe de la thermodynamique s'écrit :",
     "opciones": [
      "ΔE_tot = 0 toujours",
      "ΔU = W + Q",
      "ΔU = C·ΔT dans tous les cas",
      "ΔU = W − Q"
     ],
     "correcta": 1,
     "explicacion": "Si un système fermé au repos a une énergie qui varie, c'est qu'il échange de l'énergie avec l'extérieur : travail W ou transfert thermique Q, donc ΔU = W + Q.",
     "pagina_pdf": 421
    },
    {
     "pregunta": "Pour un système fermé, au repos et incompressible, la variation d'énergie interne vaut :",
     "opciones": [
      "ΔU = Q = C·ΔT",
      "ΔU = W + Q + C",
      "ΔU = σ·T⁴",
      "ΔU = C/ΔT"
     ],
     "correcta": 0,
     "explicacion": "Pour un système fermé au repos et incompressible : ΔU = Q = C·ΔT, avec C = m·c en J·K⁻¹.",
     "pagina_pdf": 421
    },
    {
     "pregunta": "Quelle est l'expression du flux thermique Φ, et son unité ?",
     "opciones": [
      "Φ = Δt/Q, en W·s⁻¹",
      "Φ = Q·Δt, en joule (J)",
      "Φ = C·ΔT, en J·K⁻¹",
      "Φ = Q/Δt, en watt (W)"
     ],
     "correcta": 3,
     "explicacion": "Le flux thermique est le transfert thermique Q par unité de temps entre deux milieux : Φ = Q/Δt, en watt. Il a la dimension d'une puissance.",
     "pagina_pdf": 422
    },
    {
     "pregunta": "Un système en contact avec un thermostat de température T_th (loi de Newton, dT/dt = −γ(T − T_th)) voit sa température évoluer selon :",
     "opciones": [
      "T(t) = T₀ + γ·t, croissance linéaire",
      "T(t) = T_th·e^(−γt), qui tend vers 0",
      "T(t) = (T₀ − T_th)·e^(−γt) + T_th, qui tend vers T_th",
      "T(t) = T_th, constante dès t = 0"
     ],
     "correcta": 2,
     "explicacion": "La solution est T(t) = (T₀ − T_th)·e^(−γt) + T_th : exponentielle décroissante (ou croissante) qui tend vers la température du thermostat quand t → ∞.",
     "pagina_pdf": 424
    },
