   "preguntas": [
    {
     "pregunta": "Le niveau d'intensité sonore L, exprimé en décibels (dB), est défini par :",
     "opciones": [
      "L = 10 log(I / I₀)",
      "L = I / I₀",
      "L = 20 log(I × I₀)",
      "L = 10 (I − I₀)"
     ],
     "correcta": 0,
     "explicacion": "L = 10 log(I/I₀) avec I₀ = 1,0×10⁻¹² W·m⁻² : échelle logarithmique adaptée à l'oreille.",
     "pagina_pdf": 453
    },
    {
     "pregunta": "Deux ondes de même longueur d'onde λ sont en opposition de phase (interférences destructives) lorsqu'elles sont décalées de :",
     "opciones": [
      "k × λ (k entier)",
      "(k + ½) × λ (k entier)",
      "toujours λ/4",
      "exactement 2λ"
     ],
     "correcta": 1,
     "explicacion": "Décalage de (k + ½)·λ : les amplitudes s'annulent. Décalage de k·λ : ondes en phase, interférences constructives.",
     "pagina_pdf": 454
    },
    {
     "pregunta": "L'angle caractéristique de diffraction d'une fente de largeur a, éclairée par une onde de longueur d'onde λ, vaut :",
     "opciones": [
      "θ = a / λ",
      "θ = λ × a",
      "θ = λ / a",
      "θ = 2a / λ"
     ],
     "correcta": 2,
     "explicacion": "θ = λ/a (en radians) : plus la fente est étroite, plus la diffraction est marquée.",
     "pagina_pdf": 454
    },
    {
     "pregunta": "Un train qui klaxonne s'approche de vous à vitesse importante. Par effet Doppler, le son perçu est :",
     "opciones": [
      "plus grave, car f_R < f_e",
      "inchangé, seul le niveau sonore augmente",
      "plus grave puis plus aigu",
      "plus aigu, car f_R > f_e"
     ],
     "correcta": 3,
     "explicacion": "Source qui se rapproche : f_R = f_e·c/(c − v) > f_e, donc son plus aigu ; il devient plus grave quand la source s'éloigne.",
     "pagina_pdf": 456
    }
   ]
