   "titulo": "Ejercicio de bac: fuerza de ácidos y bases",
   "preguntas": [
    {
     "pregunta": "Une solution aqueuse d'acide fort (réaction quasi-totale avec l'eau) a une concentration c en acide apporté. Quelle relation donne son pH ?",
     "opciones": [
      "pH = pKe + log c",
      "pH = − log c",
      "pH = pKA + log c",
      "pH = 14 − c"
     ],
     "correcta": 1,
     "explicacion": "Si la transformation est totale, [H₃O⁺]f = c, donc pH = −log c (ex. HCl 1,0×10⁻² mol·L⁻¹ → pH = 2,0).",
     "pagina_pdf": 185
    },
    {
     "pregunta": "Plus le pKA d'un couple acide-base est grand...",
     "opciones": [
      "plus l'acide réagit avec l'eau, donc plus il est fort",
      "moins l'acide réagit avec l'eau, donc plus il est faible et plus sa base est forte",
      "plus Ke est grand",
      "plus la solution est tampon"
     ],
     "correcta": 1,
     "explicacion": "Un pKA grand correspond à un acide qui réagit peu avec l'eau (acide faible) et à une base conjuguée plus forte.",
     "pagina_pdf": 185
    },
    {
     "pregunta": "Dans un diagramme de distribution, à quelle condition l'acide et sa base conjuguée sont-ils en proportions égales (50 % chacun) ?",
     "opciones": [
      "pH = 7",
      "pH = pKe",
      "pH = pKA",
      "pH = 0"
     ],
     "correcta": 2,
     "explicacion": "Quand [AH]f = [A⁻]f, KA = [H₃O⁺]f donc pH = pKA.",
     "pagina_pdf": 188
    },
    {
     "pregunta": "Le pH à l'équivalence du titrage de la soude par l'acide chlorhydrique vaut 7,0. Quel indicateur coloré choisir parmi ceux du tableau ?",
     "opciones": [
      "Hélianthine (3,1–4,4)",
      "Rouge de méthyle (4,2–6,2)",
      "Bleu de bromothymol (6,0–7,6)",
      "Thymolphtaléine (9,3–10,5)"
     ],
     "correcta": 2,
     "explicacion": "Le pH à l'équivalence doit se situer dans la zone de virage : 7,0 est dans 6,0–7,6, donc le BBT.",
     "pagina_pdf": 188
    }
   ]
  },
